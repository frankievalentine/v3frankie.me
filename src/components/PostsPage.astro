---
import Layout from "../layouts/Layout.astro";
import { getPostsPagePath, type Post } from "../posts";
import { formatDate, readingTime } from "../utils";

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

type PaginationItem = number | "ellipsis";

const { posts, currentPage, totalPages } = Astro.props;
const pageTitle = currentPage === 1 ? "Posts" : `Posts — Page ${currentPage}`;
const currentPath =
  currentPage === 1 ? "/posts" : getPostsPagePath(currentPage);
const previousPath =
  currentPage > 1 ? getPostsPagePath(currentPage - 1) : undefined;
const nextPath =
  currentPage < totalPages ? getPostsPagePath(currentPage + 1) : undefined;

const visiblePageNumbers = [...new Set([
  1,
  currentPage - 1,
  currentPage,
  currentPage + 1,
  totalPages,
])]
  .filter((page) => page >= 1 && page <= totalPages)
  .sort((a, b) => a - b);

const paginationItems: PaginationItem[] = [];
visiblePageNumbers.forEach((page, index) => {
  const previousPage = visiblePageNumbers[index - 1];
  if (previousPage !== undefined && page - previousPage > 1) {
    paginationItems.push("ellipsis");
  }
  paginationItems.push(page);
});

const paginationLinkClass =
  "inline-flex h-9 min-w-8 items-center justify-center gap-1.5 rounded-md border border-border bg-background px-2 text-sm font-medium text-muted-foreground outline-none ring-ring transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const paginationDisabledClass =
  "inline-flex h-9 min-w-8 items-center justify-center gap-1.5 rounded-md border border-border bg-background px-2 text-sm font-medium text-muted-foreground opacity-40";
---

<Layout title={pageTitle} currentPage={currentPath}>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Page header -->
    <div class="flex items-center gap-2 mb-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-muted-foreground"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
        <path d="M10 9H8" />
        <path d="M16 13H8" />
        <path d="M16 17H8" />
      </svg>
      <span
        class="text-xs text-muted-foreground font-medium uppercase tracking-wider"
        >Posts</span
      >
    </div>
    <h1 class="text-3xl font-bold tracking-tight mb-2">Writing</h1>
    <p class="text-muted-foreground text-sm mb-10">
      Notes on software, homelab projects, and the tools I use.
    </p>

    <!-- Post list -->
    <div class="grid gap-4">
      {posts.map((post) => (
        // biome-ignore lint/correctness/useJsxKeyInIterable: Astro's HTML attributes do not type-check the JSX key prop.
        <a href={`/posts/${post.id}`} class="block group">
          <div class="card transition-colors group-hover:bg-accent/40">
            <section>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <h2 class="text-base font-semibold text-foreground leading-snug group-hover:text-foreground mb-1">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground shrink-0 mt-1 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </div>

              <div class="mt-3 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-3">
                <div class="flex shrink-0 items-center gap-3 whitespace-nowrap">
                  <time datetime={post.data.date.toISOString()} class="text-xs text-muted-foreground">
                    {formatDate(post.data.date)}
                  </time>
                  <span class="text-border" aria-hidden="true">·</span>
                  <span class="text-xs text-muted-foreground">{readingTime(post.body ?? "")}</span>
                </div>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
                    {post.data.tags.map((tag) => (
                      // biome-ignore lint/correctness/useJsxKeyInIterable: Astro's HTML attributes do not type-check the JSX key prop.
                      <span class="badge text-xs" data-variant="secondary">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </section>
          </div>
        </a>
      ))}
    </div>

    {totalPages > 1 && (
      <nav
        class="mt-10 border-t border-border pt-6"
        aria-label="Posts pagination"
      >
        <div class="flex items-center justify-between gap-2">
          {previousPath ? (
            <a
              href={previousPath}
              rel="prev"
              class={paginationLinkClass}
              aria-label={`Previous page, page ${currentPage - 1}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
              </svg>
              <span class="hidden sm:inline">Previous</span>
            </a>
          ) : (
            <span
              class={paginationDisabledClass}
              aria-disabled="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
              </svg>
              <span class="sr-only">Previous page unavailable</span>
              <span class="hidden sm:inline" aria-hidden="true">Previous</span>
            </span>
          )}

          <ol class="flex items-center justify-center gap-1">
            {paginationItems.map((item) => (
              item === "ellipsis" ? (
                // biome-ignore lint/correctness/useJsxKeyInIterable: Astro's HTML attributes do not type-check the JSX key prop.
                <li aria-hidden="true" class="flex h-9 min-w-4 items-center justify-center text-sm text-muted-foreground">
                  …
                </li>
              ) : (
                // biome-ignore lint/correctness/useJsxKeyInIterable: Astro's HTML attributes do not type-check the JSX key prop.
                <li>
                  {item === currentPage ? (
                    <span
                      class="inline-flex h-9 min-w-8 items-center justify-center rounded-md border border-foreground bg-foreground px-2 text-sm font-semibold text-background"
                      aria-current="page"
                    >
                      <span class="sr-only">Page </span>{item}<span class="sr-only">, current page</span>
                    </span>
                  ) : (
                    <a
                      href={getPostsPagePath(item)}
                      class={paginationLinkClass}
                      aria-label={`Page ${item}`}
                    >
                      {item}
                    </a>
                  )}
                </li>
              )
            ))}
          </ol>

          {nextPath ? (
            <a
              href={nextPath}
              rel="next"
              class={paginationLinkClass}
              aria-label={`Next page, page ${currentPage + 1}`}
            >
              <span class="hidden sm:inline">Next</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          ) : (
            <span
              class={paginationDisabledClass}
              aria-disabled="true"
            >
              <span class="sr-only">Next page unavailable</span>
              <span class="hidden sm:inline" aria-hidden="true">Next</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          )}
        </div>
      </nav>
    )}
  </div>
</Layout>
