---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = `/projects/${project.id}`;
---

<a href={href} class="block group">
  <div class="card transition-colors group-hover:bg-accent/40">
    <section>
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2 -ml-1">
            <span class="badge text-[11px]" data-variant="outline">{project.data.kind}</span>
            <span class="badge text-[11px]" data-variant="secondary">
              {project.data.status}
            </span>
          </div>

          <h2 class="text-base font-semibold text-foreground leading-snug mb-1">
            {project.data.title}
          </h2>

          <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
            {project.data.description}
          </p>
        </div>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground shrink-0 mt-1 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </div>

      <div class="flex flex-wrap gap-1.5 mt-3">
        {project.data.stack.map((item) => (
          // biome-ignore lint/correctness/useJsxKeyInIterable: Astro's HTML attributes do not type-check the JSX key prop.
          <span class="badge text-xs" data-variant="secondary">{item}</span>
        ))}
      </div>
    </section>
  </div>
</a>
