---
// Renders a fixed back-to-top button that appears once the user scrolls down.
// Visibility is toggled via the `data-visible` attribute driven by a scroll listener.
interface Props {
  showAfter?: number;
}

const { showAfter = 300 } = Astro.props;
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  data-show-after={showAfter}
  data-visible="false"
  class="fixed right-6 bottom-[calc(1.5rem+env(safe-area-inset-bottom))] z-50 inline-flex size-9 items-center justify-center rounded-full border border-border bg-background text-muted-foreground shadow-sm transition-all duration-200 hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring motion-reduce:transition-none data-[visible=false]:pointer-events-none data-[visible=false]:opacity-0 data-[visible=true]:opacity-100"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<script>
  let cleanupBackToTop: (() => void) | undefined;

  function initBackToTop() {
    cleanupBackToTop?.();
    cleanupBackToTop = undefined;

    const btn = document.getElementById(
      "back-to-top",
    ) as HTMLButtonElement | null;
    if (!btn) {
      return;
    }

    const controller = new AbortController();
    cleanupBackToTop = () => controller.abort();
    const showAfter = Number(btn.dataset.showAfter) || 300;

    const setVisible = (visible: boolean) => {
      btn.dataset.visible = String(visible);
      if (visible) {
        btn.removeAttribute("aria-hidden");
        btn.removeAttribute("tabindex");
      } else {
        btn.setAttribute("aria-hidden", "true");
        btn.tabIndex = -1;
      }
    };

    const onScroll = () => {
      setVisible(window.scrollY > showAfter);
    };

    btn.addEventListener(
      "click",
      () => {
        const heading = document.querySelector<HTMLElement>("main h1");
        if (heading) {
          const hadTabIndex = heading.hasAttribute("tabindex");
          if (!hadTabIndex) heading.tabIndex = -1;
          heading.focus({ preventScroll: true });
          if (!hadTabIndex) {
            heading.addEventListener(
              "blur",
              () => heading.removeAttribute("tabindex"),
              { once: true },
            );
          }
        }

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        window.scrollTo({
          top: 0,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      },
      { signal: controller.signal },
    );

    window.addEventListener("scroll", onScroll, {
      passive: true,
      signal: controller.signal,
    });
    onScroll();
  }

  document.addEventListener("astro:page-load", initBackToTop);
</script>
