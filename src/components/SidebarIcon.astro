---
import type { SidebarIconName } from "../navigation";

interface Props {
  name: SidebarIconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === "home" && (
    <>
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </>
  )}
  {name === "layers" && (
    <>
      <path d="m3 7 9-4 9 4-9 4-9-4"></path>
      <path d="m3 12 9 4 9-4"></path>
      <path d="m3 17 9 4 9-4"></path>
    </>
  )}
  {name === "file" && (
    <>
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
      <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
      <path d="M10 9H8"></path>
      <path d="M16 13H8"></path>
      <path d="M16 17H8"></path>
    </>
  )}
  {name === "server" && (
    <>
      <rect width="20" height="8" x="2" y="3" rx="2"></rect>
      <rect width="20" height="8" x="2" y="13" rx="2"></rect>
      <path d="M6 7h.01"></path>
      <path d="M6 17h.01"></path>
      <path d="M10 7h8"></path>
      <path d="M10 17h8"></path>
    </>
  )}
  {name === "camera" && (
    <>
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
      <circle cx="12" cy="13" r="3"></circle>
    </>
  )}
  {name === "mail" && (
    <>
      <rect width="20" height="16" x="2" y="4" rx="2"></rect>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
    </>
  )}
  {name === "wrench" && (
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
  )}
</svg>
