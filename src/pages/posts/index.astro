---
import PostsPage from "../../components/PostsPage.astro";
import {
  getPostsForPage,
  getPostsPageCount,
  getSortedPosts,
} from "../../posts";

const posts = await getSortedPosts();
const totalPages = getPostsPageCount(posts.length);
---

<PostsPage
  posts={getPostsForPage(posts, 1)}
  currentPage={1}
  totalPages={totalPages}
/>
