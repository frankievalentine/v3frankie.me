---
import PostsPage from "../../../components/PostsPage.astro";
import {
  getPostsForPage,
  getPostsPageCount,
  getSortedPosts,
  type Post,
} from "../../../posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const totalPages = getPostsPageCount(posts.length);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: getPostsForPage(posts, currentPage),
        currentPage,
        totalPages,
      },
    };
  });
}

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<PostsPage
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
/>
