---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";

const featuredProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((project) => project.data.featured)
  .slice(0, 3);
---

<Layout title="About" currentPage="/">
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Bio card -->
    <div class="card mb-6">
      <header>
        <h2>About me</h2>
      </header>
      <section>
        <p class="text-sm text-muted-foreground leading-relaxed">
          My name is Frankie and I'm based in Nevada. I'm a software engineer and founder of <a
            href="https://v3digital.studio"
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline underline-offset-4 hover:text-muted-foreground transition-colors"
          >V3 Digital Studio</a>. I've spent the last eight
          years working across design and code, with a particular focus on
          performance and the details that make products feel considered. I
          care about building websites and software that are fast, useful, and
          well made. I run my own studio and work with clients on select
          projects.
        </p>

        <div class="mt-5 h-14 flex items-center">
          <img
            src="/signature-transparent.png"
            width="1022"
            height="416"
            alt="Frankie Valentine signature"
            class="block h-auto w-32 sm:w-36 dark:hidden"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/signature-dark.png"
            width="1022"
            height="416"
            alt="Frankie Valentine signature"
            class="hidden h-auto w-32 sm:w-36 dark:block"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="flex flex-wrap gap-3 mt-4">
          <a href="mailto:hello@v3frankie.me" class="btn" data-variant="outline">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m22 2-7 20-4-9-9-4Z"></path>
              <path d="M22 2 11 13"></path>
            </svg>
            Get in touch
          </a>
          <a href="/newsletter" class="btn" data-variant="outline">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            Subscribe to newsletter
          </a>
        </div>
      </section>
    </div>

    <!-- Now section -->
    <div class="card mb-6">
      <header>
        <h2>Now</h2>
      </header>
      <section>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground mt-0.5"
                aria-hidden="true"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </span>
            <span class="text-sm text-muted-foreground"
              >Building V3 Digital Studio and making thoughtful,
              high-performance products clients love</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground mt-0.5"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                ></path>
              </svg>
            </span>
            <span class="text-sm text-muted-foreground"
              >Working on Quipthread for self-hosted comments and openprexo for
              unified AI image generation across CLI and desktop</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground mt-0.5"
                aria-hidden="true"
              >
                <path
                  d="M3 7.5 12 3l9 4.5-9 4.5-9-4.5Z"
                ></path>
                <path d="M3 12.5 12 17l9-4.5"></path>
                <path d="M3 17.5 12 22l9-4.5"></path>
              </svg>
            </span>
            <span class="text-sm text-muted-foreground"
              >Developing powerhouse and spritedeck for AI-native environments
              and agent workflows</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground mt-0.5"
                aria-hidden="true"
              >
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                <path d="M10 9H8"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
              </svg>
            </span>
            <span class="text-sm text-muted-foreground"
              >Using this site to publish project notes, updates, and longer
              writing as the work develops</span
            >
          </li>
        </ul>
      </section>
    </div>

    <div class="mb-6">
      <div class="flex items-center justify-between gap-4 mb-4">
        <h2 class="text-xl font-semibold tracking-tight text-foreground">
          Featured projects
        </h2>

        <a
          href="/projects"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          View all
        </a>
      </div>

      <div class="grid gap-4">
        {featuredProjects.map((project) => (
          // biome-ignore lint/correctness/useJsxKeyInIterable: Astro components do not type-check the JSX key prop.
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </div>
</Layout>
