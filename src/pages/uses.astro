---
import Layout from "../layouts/Layout.astro";

const externalLinkClass =
  "underline decoration-muted-foreground/40 underline-offset-4 transition-colors hover:text-muted-foreground";
---

<Layout title="Uses" currentPage="/uses">
  <div class="max-w-lg mx-auto px-6 py-12 md:py-16">
    <!-- Page header -->
    <div class="flex items-center gap-2 mb-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-muted-foreground"
        aria-hidden="true"
      >
        <path
          d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
        />
      </svg>
      <span
        class="text-xs text-muted-foreground font-medium uppercase tracking-wider"
        >Uses</span
      >
    </div>

    <div class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-foreground mb-2">
        What I use
      </h1>
      <p class="text-sm text-muted-foreground">
        Hardware, software, and tools I rely on day-to-day. Updated
        occasionally.
      </p>
    </div>

    <!-- Hardware -->
    <div class="card mb-6">
      <header>
        <h2>Hardware</h2>
      </header>
      <section>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <rect width="18" height="12" x="3" y="4" rx="2" ry="2" />
              <line x1="2" x2="22" y1="20" y2="20" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.apple.com/macbook-air/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>MacBook Air 15" M4</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Laptop. The jump from Intel was significant; the M4 is barely
                worth upgrading from M1/M2 unless you're GPU-bound.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.apple.com/mac-mini/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Mac mini M4</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Desktop machine. Quiet, tiny, and more than enough for longer
                builds, exports, and anything I want to leave docked.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.msi.com/Monitors"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>MSI 27" OLED</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                External display. Good enough for photo editing; not a
                substitute for a calibrated panel.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path
                d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
              />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.gloriousgaming.com/products/gmmk-pro"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Glorious GMMK Pro Keyboard</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                75% layout, Gateron Yellow switches. Wired, sturdy, and built
                like a tank.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path
                d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
              />
              <circle cx="12" cy="13" r="3" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.fujifilm-x.com/en-us/products/cameras/x-m5/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Fujifilm X-M5</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Daily carry camera. Compact APS-C body with great AF. Paired
                mostly with the 35mm f/1.8 or the stock lens.
              </p>
            </div>
          </li>
        </ul>
      </section>
    </div>

    <!-- Development Stack -->
    <div class="card mb-6">
      <header>
        <h2>Development Stack</h2>
      </header>
      <section>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://zed.dev/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Zed</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Zed is my text editor of choice for anything with heavy tooling
                requirements. I still switch editors too often.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
              <line x1="3" x2="21" y1="9" y2="9" />
              <line x1="3" x2="21" y1="15" y2="15" />
              <line x1="9" x2="9" y1="9" y2="21" />
              <line x1="15" x2="15" y1="9" y2="21" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://ghostty.org/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Ghostty</a
                >
                {" + "}
                <a
                  href="https://github.com/alvinunreal/oh-my-opencode-slim"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Opencode Slim</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Ghostty replaced iTerm2, with Opencode Slim coordinating
                specialized agents for research, review, UI work, and focused
                implementation.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="m9 9-2 2 2 2" />
              <path d="m13 13 2-2-2-2" />
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.typescriptlang.org/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>TypeScript</a
                >
                {" + "}
                <a
                  href="https://bun.sh/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Bun</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                TypeScript everywhere. Bun as runtime, package manager, and test
                runner — it's fast enough that I stopped thinking about it.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z" />
              <path d="M7 7h.01" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://astro.build/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Astro</a
                >
                {" + "}
                <a
                  href="https://react.dev/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>React</a
                >
                {" + "}
                <a
                  href="https://tailwindcss.com/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Tailwind CSS</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Astro for content sites and static work, React when I need
                component-heavy UIs. Tailwind for both.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <ellipse cx="12" cy="5" rx="9" ry="3" />
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
              <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://pages.cloudflare.com/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Cloudflare Pages</a
                >
                {" + "}
                <a
                  href="https://workers.cloudflare.com/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Workers</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Default deployment target. The edge network and free tier make
                it hard to justify self-hosting for most projects.
              </p>
            </div>
          </li>
        </ul>
      </section>
    </div>

    <!-- Apps -->
    <div class="card">
      <header>
        <h2>Apps</h2>
      </header>
      <section>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.raycast.com/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Raycast</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                A quick launcher for apps, commands, and the small actions that
                keep my day moving.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="2" x2="22" y1="12" y2="12" />
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://helium.computer/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Helium</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Best privacy and unbiased ad-blocking by default. Handy
                features like native !bangs and split view. No adware, no
                bloat, no noise.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path
                d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
              />
              <circle cx="12" cy="13" r="3" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://www.blackmagicdesign.com/products/davinciresolve"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>DaVinci Resolve 21</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Still the best cataloging and editing workflow for high-volume
                shooting. Great Lightroom alternative now.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-foreground">
                <a
                  href="https://obsidian.md/"
                  target="_blank"
                  rel="noreferrer"
                  class={externalLinkClass}>Obsidian</a
                >
              </p>
              <p class="text-xs text-muted-foreground mt-0.5">
                Notes, references, and anything I want to keep local-first.
                Plain files, fast search, and no pressure to over-structure it.
              </p>
            </div>
          </li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
