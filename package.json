    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome lint --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-pagefind": "^2.0.1",
    "basecoat-css": "^1.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
