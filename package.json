{
	"name": "v3frankie.me",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro telemetry disable && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"cfpreview": "bun run build && astro preview",
		"cfdeploy": "bun run build && wrangler pages deploy ./dist --project-name v3frankie-me --branch main",
		"check": "astro check && biome lint .",
		"typecheck": "astro check",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"fix": "biome lint --write ."
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/partytown": "^2.1.7",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"@xyflow/react": "^12.11.2",
		"astro": "^7.1.6",
		"astro-expressive-code": "^0.44.1",
		"astro-pagefind": "^2.0.1",
		"basecoat-css": "^1.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.6",
